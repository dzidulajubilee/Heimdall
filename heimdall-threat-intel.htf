# ─────────────────────────────────────────────
# Heimdall Threat Intel Feed (.htf)
# One [entry] block per record, closed by ---
# Either sig_id OR category must be non-empty
# tags / refs = comma-separated
# Lines starting with # are comments
# ─────────────────────────────────────────────

[entry]
sig_id: 2100366
sig_msg: GPL ICMP PING *NIX
category: None
explanation: This alert indicates that a device on the network sent a standard “ping” request. Such activity is common and typically harmless, often used for routine connectivity checks or monitoring. No action required unless the activity is frequent, originates from an unknown source, or coincides with other suspicious events.
tags: 
refs: 
