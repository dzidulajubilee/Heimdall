[Unit]
Description=Heimdall IDS Dashboard
Documentation=https://github.com/heimdall-ids/heimdall
After=network.target
Wants=network.target

[Service]
Type=simple
User=heimdall
Group=heimdall
WorkingDirectory=/var/lib/heimdall

# Options come from /etc/heimdall/heimdall.conf (the /usr/bin/heimdall wrapper
# passes --config). The previous hard-coded arguments equalled the installed
# defaults, which still apply to anything the config file does not set.
ExecStart=/usr/bin/heimdall

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=heimdall

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/heimdall /var/log/heimdall
ReadOnlyPaths=/var/log/suricata
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
