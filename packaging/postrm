#!/bin/bash
set -e

if [ "$1" = "purge" ]; then
    # Remove all Heimdall directories on purge
    rm -rf /opt/heimdall
    rm -rf /etc/heimdall
    rm -rf /var/lib/heimdall
    rm -rf /var/log/heimdall

    # Remove the system user and group
    if id -u heimdall &>/dev/null; then
        userdel heimdall 2>/dev/null || true
    fi
    if getent group heimdall &>/dev/null; then
        groupdel heimdall 2>/dev/null || true
    fi
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v systemctl &>/dev/null; then
        systemctl daemon-reload 2>/dev/null || true
    fi
fi

exit 0
