#!/bin/bash
set -e

# Create dedicated system user (no login shell, no home dir)
if ! id -u heimdall &>/dev/null; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
            --comment "Heimdall IDS Dashboard" heimdall
fi

# Ensure data and log directories are owned by the service user
chown -R heimdall:heimdall /var/lib/heimdall
chown -R heimdall:heimdall /var/log/heimdall

# Make the CLI wrapper executable
chmod 755 /usr/bin/heimdall

# Reload systemd so it picks up the new unit file
if command -v systemctl &>/dev/null && systemctl is-system-running &>/dev/null; then
    systemctl daemon-reload
fi

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║            Heimdall IDS v2 — Skin System Enabled       ║"
echo "╠══════════════════════════════════════════════════════╣"
echo "║  Enable & start:   sudo systemctl enable --now heimdall  ║"
echo "║  View credentials: sudo journalctl -u heimdall -n 30     ║"
echo "║  Dashboard:        http://localhost:8765                  ║"
echo "║                                                           ║"
echo "║  Eve log path:     /var/log/suricata/eve.json             ║"
echo "║  Change password:  sudo heimdall --password <new>         ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""

exit 0
